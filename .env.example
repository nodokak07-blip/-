# Vercel server environment variables. Never add the service key to browser code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
# Existing sb_secret_... server key or legacy service_role JWT; never use in browser code.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_RATE_LIMIT_SECRET=replace-with-a-random-secret-at-least-32-characters
